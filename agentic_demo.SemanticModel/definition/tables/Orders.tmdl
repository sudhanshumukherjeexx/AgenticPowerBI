table Orders
	lineageTag: 5b81d44b-e499-4781-952d-3dc670432d7e

	measure 'Total Sales' =
			
			SUM('Orders'[Sales])
		lineageTag: 1f4140fc-da0b-40b8-b97b-0876574ebe5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Profit' = ```
			
			SUM('Orders'[Profit])
			
			```
		lineageTag: bb642919-fc92-471f-aa0e-cca9b7139887

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' =
			
			DISTINCTCOUNT('Orders'[Order ID])
		formatString: 0
		lineageTag: 78f93579-86b2-41d9-837a-bb70ac728917

	measure 'Profit Margin %' =
			
			DIVIDE([Total Profit], [Total Sales], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3433fdb0-22f1-46c0-a157-e77c31121a4b

	measure 'Average Order Value' =
			
			DIVIDE([Total Sales], [Total Orders], 0)
		lineageTag: 6f02f744-c8ab-44fe-862b-5beb49305177

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Sales Growth %' =
			
			VAR CurrentYear = YEAR(TODAY())
			VAR SalesThisYear = CALCULATE([Total Sales], YEAR('Orders'[Order Date]) = CurrentYear)
			VAR SalesLastYear = CALCULATE([Total Sales], YEAR('Orders'[Order Date]) = CurrentYear - 1)
			RETURN DIVIDE(SalesThisYear - SalesLastYear, SalesLastYear, 0)
		lineageTag: 863160c0-931d-4c51-b7ef-0ddc03b9c7d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 10 Customers by Sales' =
			
			IF(
			    RANKX(
			        ALL('Orders'[Customer ID]),
			        CALCULATE([Total Sales])
			    ) <= 10,
			    [Total Sales],
			    BLANK()
			)
		lineageTag: 5e4f7f5c-5363-42db-9e82-ca20cd43c51a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 10 Products by Profit' =
			
			IF(
			    RANKX(
			        ALL('Orders'[Product ID]),
			        CALCULATE([Total Profit])
			    ) <= 10,
			    [Total Profit],
			    BLANK()
			)
		lineageTag: 44a244c3-b57a-45bc-9964-8cde98670d97

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic Report Title' =
			
			VAR MinDate = MIN('Orders'[Order Date])
			VAR MaxDate = MAX('Orders'[Order Date])
			VAR SelectedRegion = SELECTEDVALUE('Orders'[Region], "All Regions")
			RETURN
			"Sales Report: " &
			FORMAT(MinDate, "MMM YYYY") & " - " & FORMAT(MaxDate, "MMM YYYY") &
			" | " & SelectedRegion
		lineageTag: 6ffe2045-a1bc-4111-86c6-bead55402d17

	measure 'Top Products Chart Title' =
			
			VAR SelectedRegion = SELECTEDVALUE('Orders'[Region], "All Regions")
			RETURN
			"Top Products in " & SelectedRegion
		lineageTag: 1667df7a-74f5-4a08-913f-4ee8201484e3

	measure 'Category Analysis Title' =
			
			VAR SelectedCategory = SELECTEDVALUE('Orders'[Category], "All Categories")
			VAR SelectedRegion = SELECTEDVALUE('Orders'[Region], "All Regions")
			RETURN
			SelectedCategory & " Performance in " & SelectedRegion
		lineageTag: 0dbaba17-513c-4f04-b266-42236acc1dbd

	measure 'Data Freshness Title' = ```
			
			VAR LastOrderDate = MAX('Orders'[Order Date])
			VAR DaysOld = DATEDIFF(LastOrderDate, TODAY(), DAY)
			RETURN
			"Data as of: " & FORMAT(LastOrderDate, "MMM DD, YYYY") & 
			" (" & DaysOld & " days ago)"
			```
		lineageTag: 1159c896-38dc-4db6-a521-4c697e904624

	measure YoY_Sales_Growth_% =
			
			VAR SalesThisYear = CALCULATE([Total Sales], DATESYTD('Orders'[Order Date]))
			VAR SalesLastYear = CALCULATE([Total Sales], DATESYTD(SAMEPERIODLASTYEAR('Orders'[Order Date])))
			RETURN DIVIDE(SalesThisYear - SalesLastYear, SalesLastYear, 0)
		lineageTag: ffd30723-7155-45f5-a974-268ec18065b0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'QoQ Sales Growth %' =
			
			VAR SalesThisQ = CALCULATE([Total Sales], DATESQTD('Orders'[Order Date]))
			VAR SalesPrevQ = CALCULATE([Total Sales], DATEADD(DATESQTD('Orders'[Order Date]), -1, QUARTER))
			RETURN DIVIDE(SalesThisQ - SalesPrevQ, SalesPrevQ, 0)
		lineageTag: c0a96994-1086-4d9f-bd8d-dcac1ab65ca5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '12M Rolling Avg Sales' =
			
			VAR Last12Months = DATESINPERIOD('Orders'[Order Date], LASTDATE('Orders'[Order Date]), -12, MONTH)
			RETURN
			CALCULATE(
			    AVERAGEX(
			        SUMMARIZE('Orders', 'Orders'[Order Date]),
			        [Total Sales]
			    ),
			    Last12Months
			)
		lineageTag: 050c42a4-18b9-4631-a7ea-166f064bd563

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '3M Moving Avg Sales' =
			
			CALCULATE(
			    AVERAGEX(
			        DATESINPERIOD('Orders'[Order Date], LASTDATE('Orders'[Order Date]), -3, MONTH),
			        [Total Sales]
			    )
			)
		lineageTag: c8734116-a214-4429-bf28-88a8b6f13240

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '6M Moving Avg Sales' =
			
			CALCULATE(
			    AVERAGEX(
			        DATESINPERIOD('Orders'[Order Date], LASTDATE('Orders'[Order Date]), -6, MONTH),
			        [Total Sales]
			    )
			)
		lineageTag: d1f499f7-75b0-42fc-b09c-3e3aac8f2d84

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variance %' =
			
			VAR Actual = [Total Sales]
			VAR Target = 1000000  // Set your actual target or create Target Sales measure
			RETURN DIVIDE(Actual - Target, Target, 0)
		lineageTag: 0b3cf03a-c0f7-4b15-b22a-a3042b421306

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Std Dev' =
			
			STDEVX.S(
			    SUMMARIZE('Orders', 'Orders'[Order Date], "@DailySales", [Total Sales]),
			    [@DailySales]
			)
		lineageTag: b1e549ef-399a-492e-912f-8a079abce438

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Trend Acceleration' =
			
			VAR PrevGrowth = CALCULATE([YoY_Sales_Growth_%], DATEADD('Orders'[Order Date], -1, YEAR))
			RETURN IF(ISBLANK(PrevGrowth), BLANK(), [YoY Sales Growth %] - PrevGrowth)
		lineageTag: 9f65c597-7298-4797-899e-28084529c8af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Seasonality Indicator' = ```
			
			VAR MonthAvg = 
			    CALCULATE(
			        AVERAGE('Orders'[Sales]), 
			        ALL('Orders'), 
			        MONTH('Orders'[Order Date]) = MONTH(TODAY())
			    )
			VAR YearAvg = 
			    CALCULATE(
			        AVERAGE('Orders'[Sales]), 
			        ALL('Orders')
			    )
			RETURN 
			    DIVIDE(MonthAvg, YearAvg, 0)
			```
		lineageTag: 5d515522-33c8-4d88-9302-a875d0f81fdd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 10 Customer Flag' =
			
			VAR CustomerRank = RANKX(ALL('Orders'[Customer Name]), [Total Sales],, DESC)
			RETURN IF(CustomerRank <= 10, [Total Sales], BLANK())
		lineageTag: 8b70ce32-8a26-4dd9-af46-75037e23c157

