	measure 'Adjusted Price' =
			
			SUMX(
			    'Orders',
			    ([Unit Price] * 'Orders'[Quantity]) * (1 + SELECTEDVALUE('Price Adjustment %'[Price Adjustment %])) //'Price Adjustment %'[Price Adjustment % Value], 0))
			)
		lineageTag: 84d2b29d-6e86-45b5-a273-eb8f65687da1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

