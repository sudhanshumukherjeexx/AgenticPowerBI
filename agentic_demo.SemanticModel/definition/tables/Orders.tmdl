	measure 'Customer Status' = ```
			
			VAR DaysSinceLastOrder = DATEDIFF(CALCULATE(MAX('Orders'[Order Date]), ALL('Orders'[Order Date])), TODAY(), DAY)
			RETURN
			SWITCH(
			    TRUE(),
			    DaysSinceLastOrder <= 90, "Active",
			    DaysSinceLastOrder <= 365, "At Risk",
			    "Inactive"
			)
			
			```
